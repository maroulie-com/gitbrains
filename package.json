{
  "name": "gitbrains",
  "displayName": "GitBrains",
  "description": "Git helpers: rollback, diff, blame annotations, and commit viewer",
  "version": "0.1.6",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "publisher": "maroulie-com",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maroulie-com/gitbrains.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "gitHelpers.submenu",
        "label": "Git"
      }
    ],
    "commands": [
      {
        "command": "gitHelpers.rollback",
        "title": "Rollback"
      },
      {
        "command": "gitHelpers.localRollback",
        "title": "Reset HEAD"
      },
      {
        "command": "gitHelpers.showDiff",
        "title": "Show Diff"
      },
      {
        "command": "gitHelpers.compareWithBranch",
        "title": "Compare with Branch"
      },
      {
        "command": "gitHelpers.showCommit",
        "title": "Show Commit"
      },
      {
        "command": "gitHelpers.toggleAnnotate",
        "title": "Toggle Blame"
      },
      {
        "command": "gitHelpers.resolveConflict",
        "title": "Resolve Conflict"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "gitHelpers.submenu",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "gitHelpers.submenu",
          "group": "navigation"
        }
      ],
      "gitHelpers.submenu": [
        {
          "command": "gitHelpers.rollback",
          "when": "gitHelpers.hasOriginHead",
          "group": "1_rollback@1"
        },
        {
          "command": "gitHelpers.localRollback",
          "group": "1_rollback@2"
        },
        {
          "command": "gitHelpers.showDiff",
          "group": "2_diff@1"
        },
        {
          "command": "gitHelpers.compareWithBranch",
          "group": "2_diff@2"
        },
        {
          "command": "gitHelpers.showCommit",
          "group": "3_commit@1"
        },
        {
          "command": "gitHelpers.toggleAnnotate",
          "group": "3_commit@2"
        },
        {
          "command": "gitHelpers.resolveConflict",
          "group": "4_conflict@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
